# Base URL of the SPS attendance PHP website.
# NOTE: The site's HTTPS certificate is currently issued for ftp.spscsialkot.com
# (NOT attendance.spscsialkot.com), so Android refuses to connect over HTTPS.
# Until the certificate is fixed, use plain HTTP (default below) — the app enables
# cleartext traffic via expo-build-properties. Switch to https:// once the cert is
# re-issued to cover attendance.spscsialkot.com.
EXPO_PUBLIC_BASE_URL=http://140.245.1.42
