{
  "expo": {
    "name": "SPS Attendance",
    "slug": "sps-attendance",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",

    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#F5F7FA"
    },

    "assetBundlePatterns": ["**/*"],

    "ios": {
      "supportsTablet": false
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F5F7FA"
      },
      "package": "com.sps.attendance",
      "versionCode": 5
    },

    "web": {
      "favicon": "./assets/favicon.png"
    },

    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "SPS Attendance uses the camera to recognise students for face attendance.",
          "recordAudioAndroid": false
        }
      ],
      "expo-secure-store",
      "./plugins/withWhatsApp",
      "./plugins/withExpoCameraMaven",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 1284,
          "resizeMode": "cover",
          "backgroundColor": "#F5F7FA"
        }
      ]
    ],

    "scheme": "spsattendance",

    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
